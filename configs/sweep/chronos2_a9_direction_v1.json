{
  "schema": "ffm_chronos2_a9_sweep_v1",
  "description": "TPE search over A9 (direction BCE on the consumer REG embedding): direction weight, focal gamma, horizon set and LoRA learning rate. Select period only; outer and the 2026 holdout stay untouched.",
  "study": {
    "name": "a9_direction_v1",
    "storage": "temp/chronos2_small_36stream/forecast_direction/sweep/a9_direction_v1/study.db",
    "sampler": {
      "type": "tpe",
      "seed": 0,
      "n_startup_trials": 3
    },
    "pruner": {
      "type": "percentile",
      "percentile": 25.0,
      "n_startup_trials": 5,
      "n_warmup_steps": 5,
      "interval_steps": 1
    }
  },
  "search_space": {
    "direction_weight": [
      1.0,
      2.0,
      3.0,
      5.0,
      10.0
    ],
    "focal_gamma": [
      0.0,
      1.0,
      2.0
    ],
    "reg_horizons": [
      "5",
      "5,10",
      "5,10,20"
    ],
    "learning_rate": [
      5e-06,
      1e-05,
      2e-05,
      5e-05
    ]
  },
  "objective": {
    "probe_horizons": [
      5,
      10,
      20
    ],
    "wql_budget": 1.02,
    "penalty_weight": 1.0,
    "reference_eval": "temp/chronos2_small_36stream/forecast_direction/eval/rescore_a1_select.json"
  },
  "training": {
    "parent": "temp/chronos2_small_36stream/mask_full/checkpoint",
    "epochs": 20,
    "steps_per_epoch": 100,
    "batch_windows": 32,
    "weight_decay": 0.01,
    "patience": 3,
    "select_anchors_per_stream": 100,
    "seed": 0
  },
  "evaluation": {
    "anchors_per_stream": 1000,
    "baseline_train_per_stream": 3000,
    "probe_train_per_stream": 1500,
    "probe_eval_per_stream": 1000
  },
  "seed_trials": [
    {
      "params": {
        "direction_weight": 3.0,
        "focal_gamma": 0.0,
        "reg_horizons": "5,10,20",
        "learning_rate": 1e-05
      },
      "evaluation": "temp/chronos2_small_36stream/forecast_direction/a9_lam3_seed0/eval/a9_lam3_seed0_select.json",
      "probe": "temp/chronos2_small_36stream/forecast_direction/eval/a9_lam3_regprobe_select.json"
    }
  ],
  "n_trials": 30,
  "confirmation": {
    "top_k": 3,
    "seeds": [
      0,
      1,
      2
    ],
    "rule": "re-run the top-3 trials with 3 seeds each; pick the best mean score; outer period read once only after that"
  },
  "confirmation_evaluation": {
    "anchors_per_stream": 2000,
    "baseline_train_per_stream": 3000,
    "probe_train_per_stream": 1500,
    "probe_eval_per_stream": 1500
  }
}
